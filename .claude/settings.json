{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/guard-git-history.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ]
  }
}
