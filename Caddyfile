# Shared static-SPA server for the frontend apps (M1-06).
{
	admin off
	auto_https off
}

# Railway injects $PORT; default to 8080 for local `docker run` smoke tests.
:{$PORT:8080} {
	encode gzip

	# Liveness endpoint for Railway's healthcheck — answered before the filesystem.
	handle /health {
		respond "OK" 200
	}

	# Source maps go to Sentry privately; never serve one.
	@maps path *.map
	handle @maps {
		respond 404
	}

	# Static assets with history-API fallback so client-side routing and deep links work.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
