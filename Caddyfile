# Shared static-SPA server for the frontend apps (M1-06).
{
	admin off
	auto_https off
}

# Cloud Run injects $PORT; default to 8080 for local `docker run` smoke tests.
:{$PORT:8080} {
	encode gzip

	# No site may frame the apps, and every response carries these headers, /health and the .map 404 included.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# A page revalidates on every load; /assets/ keeps its cache. status 2xx leaves the 404's no-store.
	header {
		Cache-Control "no-cache"
		match {
			status 2xx
			header Content-Type text/html*
		}
	}

	# A 304 carries no Content-Type, so a page's 304 is told by its address: no file extension.
	@pageAddress not path_regexp \.[A-Za-z0-9]+$
	header @pageAddress {
		Cache-Control "no-cache"
		match status 304
	}

	# The LB cannot add the HSTS header to its own redirects, so these hosts route here.
	@apex host ascomply.com
	handle @apex {
		redir https://www.ascomply.com{uri} 301
	}

	@blogUnderBase {
		host blog.ascomply.com
		# path_regexp is case-sensitive; the path matcher is not.
		path_regexp ^/blog(/.*)?$
	}
	handle @blogUnderBase {
		redir https://www.ascomply.com{uri} 301
	}
	@blogOld host blog.ascomply.com
	handle @blogOld {
		redir https://www.ascomply.com/blog{uri} 301
	}

	@libraryUnderBase {
		host library.ascomply.com
		path_regexp ^/library(/.*)?$
	}
	handle @libraryUnderBase {
		redir https://www.ascomply.com{uri} 301
	}
	@libraryOld host library.ascomply.com
	handle @libraryOld {
		redir https://www.ascomply.com/library{uri} 301
	}

	# Liveness, answered before the filesystem; /library/health and /check/health are under their bases.
	# Cloud Run reserves /healthz on run.app.
	@health path /health /library/health /check/health
	handle @health {
		respond "OK" 200
	}

	# Source maps go to Sentry privately; never serve one.
	@maps path *.map
	handle @maps {
		respond 404
	}

	# A site that ships /404.html serves only built addresses; the app and consoles keep the SPA fallback.
	@strict file {
		root /srv
		try_files /404.html
	}
	handle @strict {
		root * /srv
		# route keeps this order. The 404 sends no validators and ignores conditionals:
		# a 304-style empty 404 renders blank.
		route {
			# A copy is reached by its page address, never as .../index.html.
			@indexFile path */index.html
			rewrite @indexFile /404.html
			try_files {path} {path}/index.html /404.html
			@notFound path /404.html
			request_header @notFound -If-None-Match
			request_header @notFound -If-Modified-Since
			request_header @notFound -If-Match
			request_header @notFound -If-Unmodified-Since
			request_header @notFound -If-Range
			request_header @notFound -Range
			header @notFound {
				-ETag
				-Last-Modified
				Cache-Control no-store
			}
			file_server @notFound {
				status 404
			}
			file_server
		}
	}

	# Static assets with history-API fallback so client-side routing and deep links work.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
